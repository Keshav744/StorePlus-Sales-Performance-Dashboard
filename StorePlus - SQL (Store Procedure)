Create or Alter
  PROCEDURE [dbo].[Dashboard_Query]
AS
BEGIN
    SET NOCOUNT ON;

    IF OBJECT_ID(N'dbo.Dashboard_SalesTarget', N'U') IS NOT NULL
        DROP TABLE dbo.Dashboard_SalesTarget;

    IF OBJECT_ID(N'dbo.Dashboard_Sales', N'U') IS NOT NULL
        DROP TABLE dbo.Dashboard_Sales;

    -- Dashboard_Sales
    SELECT
        CONVERT(DECIMAL(10, 0), St.store_id) AS StoreID,
        st.store_name AS StoreName,
        st.region AS Region,
        st.state AS State,
        st.city AS City,
        st.store_type AS StoreType,
        st.manager_name AS Manager,
        c.customer_id,
        c.customer_name AS Customer,
        order_date AS Order_Date,
        CASE
            WHEN c.gender = 'M' THEN 'Male'
            WHEN c.gender = 'F' THEN 'Female'
            ELSE NULL
        END AS Gender,
        CASE
            WHEN age IS NULL OR age < 0 THEN 'Unknown'
            WHEN age < 18 THEN 'Under 18'
            WHEN age <= 24 THEN '18–24'
            WHEN age <= 34 THEN '25–34'
            WHEN age <= 44 THEN '35–44'
            WHEN age <= 54 THEN '45–54'
            WHEN age <= 64 THEN '55–64'
            ELSE '65+'
        END AS AgeRange,
        c.age AS Age,
        c.city AS Customercity,
        c.segment AS Segment,
        p.product_name AS Product,
        p.category AS Category,
        p.sub_category AS SubCategory,
        p.unit_cost AS UnitCost,
        p.unit_price AS UnitPrice,
        s.quantity AS Quantity,
        CONVERT(DECIMAL(10, 2), quantity * s.unit_price) AS Before_Discount,
        s.discount_pct AS Discount_Percent,
        CONVERT(
            DECIMAL(10, 2),
            s.quantity * s.unit_price * s.discount_pct / 100.0
        ) AS Discount_Amount,
        CONVERT(DECIMAL(10, 2), s.sales_amount) AS NetSales,
        s.payment_mode AS Payment_Mode,
        MONTH(order_date) AS Month,
        YEAR(order_date) AS Year
    INTO dbo.Dashboard_Sales
    FROM sales AS S
    JOIN stores AS ST
        ON s.store_id = st.store_id
    JOIN products AS P
        ON p.product_id = s.product_id
    JOIN customers AS C
        ON c.customer_id = s.customer_id
    ORDER BY st.store_id, order_date;

    -- Sales Target
    SELECT
        CONVERT(DECIMAL(10, 0), store_id) AS StoreID,
        TRY_CONVERT(INT, LEFT(month, 4)) AS [Year],
        TRY_CONVERT(INT, RIGHT(month, 2)) AS [Month],
        sales_target
    INTO dbo.Dashboard_SalesTarget
    FROM store_targets;
END;
